{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/main.ts", "src/preload.ts", "src/types.ts", "src/config.ts", "src/hotkey.ts", "src/whisper.ts", "src/commands.ts", "src/setup.ts"]
}
